# Site settings for the VPS. Copy to /etc/catharsis/site.env (root:catharsis, mode 640) and replace the domain.
# No secrets here: the admin password hash stays in site/data/auth.json, wallet keys stay in the plugin's
# secrets.yml. With none of these set, the site behaves exactly like the local setup (127.0.0.1:8791).

# Where node listens. Keep 127.0.0.1: only Caddy talks to it.
SITE_HOST=127.0.0.1
SITE_PORT=8791

# The address people open (no trailing slash). Used for canonical / og tags, sitemap.xml, robots.txt,
# deed metadata links and the admin Origin check, and the session cookie gets "Secure" when it is https.
PUBLIC_URL=https://play.example.com

# The game WebSocket handed out by /api/join. Leave unset to use wss://<host of PUBLIC_URL>, which is what the
# Caddyfile serves. The browser client only joins its own page host.
# JOIN_URL=wss://play.example.com

# Paper, for the "server online" probe on /api/join.
PAPER_HOST=127.0.0.1
PAPER_PORT=25565

# Proxies whose X-Forwarded-For / X-Forwarded-Proto are believed (IP literals). Caddy on the same machine.
TRUSTED_PROXIES=127.0.0.1,::1

# Extra origins allowed to use the admin pages (comma separated). Default: the origin of PUBLIC_URL.
# ALLOWED_ORIGINS=https://play.example.com
