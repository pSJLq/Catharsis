# Copy to .env and fill locally. Never commit .env or a real key.
# Used only by the optional deploy scripts in scripts/deploy/.

# Hex private key of the deployer account (64 hex chars, with or without 0x).
PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY

# Somnia Shannon testnet
RPC_URL=https://api.infra.testnet.somnia.network
CHAIN_ID=50312
